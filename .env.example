APP_NAME=KSP Generator
APP_ENV=production
APP_URL=https://your-domain.example
FRONTEND_URL=https://your-domain.example
VITE_API_URL=https://api.your-domain.example
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql+asyncpg://ksp_app:CHANGE_THIS_TO_A_LONG_RANDOM_APP_PASSWORD@postgres:5432/ksp
BOT_DATABASE_URL=postgresql+asyncpg://ksp_bot:CHANGE_THIS_TO_A_LONG_RANDOM_BOT_PASSWORD@postgres:5432/ksp
POSTGRES_DB=ksp
POSTGRES_USER=ksp
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_SUPERUSER_PASSWORD
POSTGRES_APP_USER=ksp_app
POSTGRES_APP_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_APP_PASSWORD
POSTGRES_BOT_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_BOT_PASSWORD
TELEGRAM_BOT_TOKEN=
BOT_USERNAME=
# ==========================================
# AI CONFIGURATION
# ==========================================

# Main AI provider
AI_PROVIDER=google

# ==========================================
# GOOGLE GEMINI
# ==========================================

GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-3.5-flash-lite

# ==========================================
# OPENROUTER FREE FALLBACK
# ==========================================

OPENROUTER_API_KEY=

# OpenRouter API base URL
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Automatically selects an available free model
OPENROUTER_MODEL=openrouter/free
OPENROUTER_TIMEOUT=90
AI_TEST_MODE=false
DEV_AUTH_ENABLED=false
PAYMENT_TEST_MODE=false
PAYMENT_PROVIDER=mock
PAYMENT_PROVIDER_TOKEN=
ADMIN_TELEGRAM_IDS=
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=10485760
FREE_GENERATIONS=3
MAX_AI_REQUESTS_PER_HOUR=20
MAX_TEMPLATES_PER_USER=20

# One primary attempt, one fallback, bounded total wall-clock latency.
AI_PRIMARY_TIMEOUT=15
AI_FALLBACK_TIMEOUT=8
AI_TOTAL_TIMEOUT=24
